<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.quadballholic</groupId>
    <artifactId>quadballholic-microservices</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>quadballholic-microservices</name>
    <description>Microservices Architecture for Quadballholic</description>
    <packaging>pom</packaging> <properties>
    <java.version>21</java.version>
    <spring-cloud.version>2024.0.0</spring-cloud.version>
</properties>

    <modules>
        <module>discoveryServer</module>
        <module>apiGateway</module>
        <module>common-library</module>
        <module>userAuth</module>
        <module>team</module>
        <module>match</module>
        <module>player</module>
        <module>stadium</module>
        <module>live-game-events</module>
        <module>reservation</module>
        <module>tournaments</module>
        <module>match_official</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>